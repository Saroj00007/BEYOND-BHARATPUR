PORT=4000
WEB_ORIGIN=http://localhost:3000

# Public OpenStreetMap-backed services used for live geocoding, road routing and place discovery.
# Keep the default values unless you run your own instances.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Lightweight fallback geocoder used if Nominatim is temporarily unavailable.
PHOTON_URL=https://photon.komoot.io/api/
ROUTING_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
HTTP_USER_AGENT=YatraAI/0.2 (Bharatpur tourism prototype)

# Required for live route-aware web discovery. Get one at https://tavily.com/
TAVILY_API_KEY=

# Optional: enables LangGraph's AI-written route summary and recommendations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
